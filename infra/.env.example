# Copy to infra/.env on the VPS. Never commit the real file.
SHIFTPROOF_DOMAIN=shiftproof.swoop.video
SHIFTPROOF_ORIGIN_PORT=18043

SHIFTPROOF_WEB_IMAGE=shiftproof-web:local
SHIFTPROOF_API_IMAGE=shiftproof-api:local

POSTGRES_DB=shiftproof
POSTGRES_USER=shiftproof
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-value
DATABASE_URL=postgresql://shiftproof:replace-with-a-long-random-url-safe-value@db:5432/shiftproof

LOG_LEVEL=info
CORS_ORIGINS=https://shiftproof.swoop.video
REVIEWER_ACCESS_TOKEN=replace-with-a-long-random-reviewer-capability-token
